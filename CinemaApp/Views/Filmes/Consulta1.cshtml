@model List<object>
@{
    ViewData["Title"] = "Consulta 1 - Filmes e Categorias";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Filmes</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </nav>

            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">@ViewData["Title"]</h2>
                    <small>Selecione uma categoria para filtrar os filmes</small>
                </div>
                <div class="card-body">
                    <!-- FORMULÁRIO -->
                    <div class="card mb-4">
                        <div class="card-body">
                            <form method="get" asp-action="Consulta1">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="categoriaId">Selecione a Categoria:</label>
                                            <select class="form-control" id="categoriaId" name="categoriaId">
                                                <option value="">-- Todas as Categorias --</option>
                                                @foreach (var categoria in ViewBag.Categorias)
                                                {
                                                    <option value="@categoria.Value"
                                                            selected="@(categoria.Value == ViewBag.CategoriaSelecionada?.ToString())">
                                                        @categoria.Text
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6 align-self-end">
                                        <button type="submit" class="btn btn-success">
                                            <i class="fas fa-search"></i> Filtrar
                                        </button>
                                        <a href="@Url.Action("Consulta1")" class="btn btn-secondary">
                                            <i class="fas fa-times"></i> Limpar
                                        </a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- RESULTADOS -->
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Filme</th>
                                        <th>Ano</th>
                                        <th>Idade</th>
                                        <th>Categoria</th>
                                        <th>Descrição da Categoria</th>
                                        <th>Produtora</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (dynamic item in Model)
                                    {
                                        <tr>
                                            <td>@item.Filme</td>
                                            <td>@item.Ano</td>
                                            <td>@item.Idade anos</td>
                                            <td>@item.Categoria</td>
                                            <td>@item.DescricaoCategoria</td>
                                            <td>@item.Produtora</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <div class="alert alert-success">
                                <strong>Consulta executada com sucesso!</strong><br>
                                <small>Total de registros encontrados: @Model.Count</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <strong>Nenhum resultado encontrado!</strong><br>
                            <small>Tente selecionar uma categoria diferente ou verifique se existem filmes cadastrados.</small>
                        </div>
                    }

                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Voltar para Lista de Filmes
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>