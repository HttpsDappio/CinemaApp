@model CinemaApp.Models.Ator

@{
    ViewData["Title"] = "Excluir Ator";
}

<h1>Excluir Ator</h1>

<h3>Tem certeza que deseja excluir este ator?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nacionalidade)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nacionalidade)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="AtorId" />
        <input type="submit" value="Excluir" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Voltar para Lista</a>
    </form>
</div>